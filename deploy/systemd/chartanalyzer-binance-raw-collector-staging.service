[Unit]
Description=ChartAnalyzer STAGING Binance Spot and USD-M raw capture (validation only)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=chartanalyzer
Group=chartanalyzer
WorkingDirectory=/opt/chartanalyzer-collector-test
Environment=PYTHONUNBUFFERED=1
Environment=CHARTANALYZER_DATA_DIR=/var/lib/chartanalyzer/binance_raw_staging
Environment=CHARTANALYZER_BINANCE_FSYNC_EVERY_EVENTS=100
Environment=CHARTANALYZER_BINANCE_HEALTH_EVERY_EVENTS=1000
ExecStartPre=/usr/bin/test -d /opt/chartanalyzer-collector-test
ExecStartPre=/opt/chartanalyzer-collector-test/.venv/bin/python -c 'import websockets'
ExecStart=/opt/chartanalyzer-collector-test/.venv/bin/python /opt/chartanalyzer-collector-test/binance_stream_collector.py --data-dir /var/lib/chartanalyzer/binance_raw_staging --symbol BTCUSDT
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/chartanalyzer/binance_raw_staging
UMask=0077

[Install]
WantedBy=multi-user.target
