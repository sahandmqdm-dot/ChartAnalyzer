[Unit]
Description=ChartAnalyzer raw Binance Spot and USD-M Futures capture
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=chartanalyzer
Group=chartanalyzer
WorkingDirectory=/opt/chartanalyzer
Environment=PYTHONUNBUFFERED=1
Environment=CHARTANALYZER_DATA_DIR=/var/lib/chartanalyzer/binance_raw
Environment=CHARTANALYZER_BINANCE_FSYNC_EVERY_EVENTS=100
Environment=CHARTANALYZER_BINANCE_HEALTH_EVERY_EVENTS=1000
ExecStartPre=/usr/bin/test -d /opt/chartanalyzer
ExecStartPre=/opt/chartanalyzer/.venv/bin/python -c 'import websockets'
ExecStart=/opt/chartanalyzer/.venv/bin/python /opt/chartanalyzer/binance_stream_collector.py --data-dir /var/lib/chartanalyzer/binance_raw --symbol BTCUSDT
Restart=always
RestartSec=10
LimitNOFILE=65536
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/chartanalyzer/binance_raw
UMask=0077

[Install]
WantedBy=multi-user.target
