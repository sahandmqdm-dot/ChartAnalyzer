[Unit]
Description=ChartAnalyzer raw Binance Spot and USD-M Futures capture
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=chartanalyzer
Group=chartanalyzer
WorkingDirectory=/opt/chartanalyzer
Environment=PYTHONUNBUFFERED=1
Environment=CHARTANALYZER_DATA_DIR=/var/lib/chartanalyzer/binance_raw
ExecStartPre=/usr/bin/test -d /opt/chartanalyzer
ExecStart=/opt/chartanalyzer/.venv/bin/python /opt/chartanalyzer/binance_stream_collector.py --data-dir /var/lib/chartanalyzer/binance_raw --symbol BTCUSDT
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/chartanalyzer/binance_raw
UMask=0077

[Install]
WantedBy=multi-user.target
