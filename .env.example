APP_ENV=development
APP_SECRET=replace-with-a-random-secret-32-bytes-or-more
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_TTL_SECONDS=1800
MARKET_DATA_PROVIDER=binance_spot # binance_spot | bybit_spot | nobitex_spot
FUTURES_MARKET_DATA_PROVIDER=binance_usdm_futures
MAX_ACTIVE_FUTURES_MARKET_STREAMS=10
MAX_ACTIVE_OPEN_INTEREST_COLLECTORS=10
MAX_ACTIVE_LIQUIDATION_STREAMS=10
POSTGRES_DB=chartanalyzer
POSTGRES_USER=chartanalyzer
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
LIQUIDATION_RETENTION_DAYS=90
